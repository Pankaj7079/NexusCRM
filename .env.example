# Application Config
PROJECT_NAME="NexusCRM"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-nexuscrm-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Falls back to local SQLite if Postgres is unavailable)
DATABASE_URL="sqlite+aiosqlite:///./nexuscrm.db"
# POSTGRES_URL="postgresql+asyncpg://crm_user:crm_password@localhost:5432/nexuscrm"

# Redis & Cache
REDIS_URL="redis://localhost:6379/0"

# Vector Store (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="crm_knowledge_base"

# LLM Provider Keys
GROQ_API_KEY=""
GOOGLE_API_KEY=""
LLAMA_CLOUD_API_KEY=""

# Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="nexuscrm-pro"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# MCP Ports
MCP_CRM_PORT=8010
MCP_EMAIL_PORT=8011
MCP_SEARCH_PORT=8012
MCP_ANALYTICS_PORT=8013

# A2A Ports
A2A_SALES_PORT=8001
A2A_SUPPORT_PORT=8002
